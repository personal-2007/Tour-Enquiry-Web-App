# ====================================================================
# Growfinix Tour Enquiry Web App — Environment Variables Template
# ====================================================================

# --------------------------------------------------------------------
# Backend Configuration (server/.env)
# --------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Supabase / Render / Local)
# Example Supabase: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Example Local: postgresql://postgres:postgres@localhost:5432/tour_enquiry_db
DATABASE_URL=postgresql://username:password@localhost:5432/tour_enquiry_db

# SSL for Cloud Database Connections (set to true for Supabase, Render, Neon)
DATABASE_SSL=false

# In-memory PostgreSQL engine fallback when local PostgreSQL is not installed (true / false)
USE_PG_MEM=false

# JWT Secret Key (minimum 32 characters)
JWT_SECRET=your_secure_random_jwt_secret_at_least_32_characters

# Client Origin URL for CORS
CLIENT_URL=http://localhost:5173

# Default Initial Administrator Account (applied via npm run db:seed)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@wanderflow.com
ADMIN_PASSWORD=Admin@123

# --------------------------------------------------------------------
# Frontend Configuration (client/.env)
# --------------------------------------------------------------------
# Leave empty in local dev to use Vite proxy (/api). Set for production deployment.
VITE_API_BASE_URL=
