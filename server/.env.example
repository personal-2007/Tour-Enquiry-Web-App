# Server Port
PORT=5000

# Environment mode: development | production | test
NODE_ENV=development

# PostgreSQL Connection String (Supabase / Render / Local)
# Example Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Example Local: postgresql://postgres:postgres@localhost:5432/tour_enquiry_db
DATABASE_URL=postgresql://username:password@localhost:5432/tour_enquiry_db

# SSL Database connection flag (set to true for cloud providers like Supabase / Render / Neon)
DATABASE_SSL=false

# In-memory PostgreSQL engine fallback when local PostgreSQL is not installed (true / false)
USE_PG_MEM=false

# JWT Secret Key for Signing Authentication Tokens
JWT_SECRET=your_secure_random_jwt_secret_at_least_32_characters

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Initial Administrator Credentials (used by npm run db:seed)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@wanderflow.com
ADMIN_PASSWORD=Admin@123
